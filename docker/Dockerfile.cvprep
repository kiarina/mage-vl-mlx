# cv-preinfer runs only on Linux: codec-video-prep ships manylinux wheels with
# no sdist and no macOS build. This image lets a Mac drive it through Docker.
FROM python:3.12-slim-bookworm

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --root-user-action=ignore codec-video-prep==0.2.5

ENTRYPOINT ["cv-preinfer"]
